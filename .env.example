# Database — a local SQLite file by default. For production, a Turso/libSQL URL + token.
DATABASE_URL=file:./data/posh.db
# On Vercel, connect Turso from Storage -> Marketplace instead (it sets TURSO_DATABASE_URL / TURSO_AUTH_TOKEN).
DATABASE_AUTH_TOKEN=

# Long random string used to sign session cookies (required in production).
SESSION_SECRET=change-me-to-a-long-random-string

# Public site URL, used for SEO metadata and Paystack callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (https://dashboard.paystack.com/#/settings/developers).
# Card payments are offered at checkout only when PAYSTACK_SECRET_KEY is set.
PAYSTACK_SECRET_KEY=

# Where uploaded product images are stored on disk.
UPLOAD_DIR=./uploads

# Vercel Blob: set automatically when a Blob store is connected on Vercel. Uploaded photos are stored there.
BLOB_READ_WRITE_TOKEN=

# First admin, created during deploy if no admin exists yet (password: 10+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
